// Schema dati di "Il Mio Congelatore".
// Ogni prodotto appartiene a un Congelatore (Freezer). Ogni Congelatore ha
// un proprietario e può avere altri membri (condivisione familiare).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Autenticazione (Auth.js) ------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Solo per il login email/password. Assente per chi entra solo con Google.
  passwordHash  String?

  accounts    Account[]
  sessions    Session[]
  memberships HouseholdMember[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Profili e condivisione -----------------------------------------

enum FreezerRole {
  OWNER
  MEMBER
}

// Il "profilo" di una persona: raggruppa tutti i suoi congelatori (es.
// "Cucina" e "Scannafosso") sotto un unico nome condivisibile. Si
// condivide il profilo intero, non un congelatore alla volta: chi entra
// vede tutti i congelatori di quella persona.
model Household {
  id   String @id @default(cuid())
  name String

  members  HouseholdMember[]
  freezers Freezer[]
  invites  HouseholdInvite[]

  createdAt DateTime @default(now())
}

// Chi può vedere/modificare i congelatori di un profilo. Il proprietario è
// comunque un membro con ruolo OWNER: non serve un campo ownerId separato.
model HouseholdMember {
  id          String      @id @default(cuid())
  householdId String
  userId      String
  role        FreezerRole @default(MEMBER)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([householdId, userId])
}

// Codice/link condivisibile su WhatsApp per unirsi a un intero profilo
// (tutti i suoi congelatori insieme).
model HouseholdInvite {
  id          String   @id @default(cuid())
  code        String   @unique
  householdId String

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// Un congelatore fisico dentro un profilo (es. "Cucina", "Scannafosso").
model Freezer {
  id          String @id @default(cuid())
  householdId String
  name        String

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  products  Product[]

  createdAt DateTime @default(now())
}

// --- Contenuto del congelatore -------------------------------------------

enum Category {
  CARNE
  PESCE
  VERDURE
  PIATTI_PRONTI
  PIZZA
  PANE
  DOLCI
  GELATI
  LATTICINI
  SUGHI
  ALTRO
}

// Da dove viene la data di consumo mostrata all'utente.
enum DateSource {
  ACTUAL // data reale, letta dalla confezione o inserita dall'utente
  ESTIMATED // stima calcolata (es. da data di congelamento + durata tipica)
  MISSING // nessuna data disponibile: non è stato inventato nulla
}

enum ProductStatus {
  ACTIVE // ancora nel congelatore
  CONSUMED // consumato dall'utente
}

model Product {
  id        String  @id @default(cuid())
  freezerId String
  freezer   Freezer @relation(fields: [freezerId], references: [id], onDelete: Cascade)

  name     String
  brand    String?
  category Category
  quantity String? // testo libero: "4 pezzi", "1 kg", "2 confezioni"...
  notes    String?

  purchaseDate DateTime? // data di acquisto (opzionale)
  frozenDate   DateTime? // data di congelamento (opzionale)
  expiryDate   DateTime? // vera data di scadenza, se stampata sulla confezione

  // Data mostrata come "consumo consigliato" quando non c'è una vera scadenza.
  recommendedConsumptionDate DateTime?
  dateSource                 DateSource @default(MISSING)
  dateReason                 String? // es. "durata consigliata per lasagne cotte congelate"
  dateReference              String? // fonte usata per la stima

  status     ProductStatus @default(ACTIVE)
  consumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freezerId, status, category])
  @@index([freezerId, status, recommendedConsumptionDate])
  @@index([freezerId, status, expiryDate])
}
