# Copia questo file in ".env" e completa i valori.

# Stringa di connessione Postgres. In produzione su Vercel:
# Dashboard progetto -> Storage -> Create Database -> Postgres (Neon), free tier.
# Vercel imposta automaticamente la variabile giusta: copiala qui come DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/freezer?schema=public"

# Chiave per il riconoscimento delle foto (confezioni e foglio cartaceo).
# Server-side only: MAI esporre questa chiave al browser.
# Creane una su https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# Auth.js — chiave per firmare le sessioni. Generala con:
#   openssl rand -base64 32
AUTH_SECRET=""

# Login con Google. Crea un "ID client OAuth" su:
# https://console.cloud.google.com/apis/credentials
# Tipo applicazione: Applicazione web.
# URI di reindirizzamento autorizzato: https://TUO-DOMINIO/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
